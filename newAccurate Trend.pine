//@version=5
indicator("Trend Volume & Price Momentum (Correct Pivot Capture)", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//=========================
// Inputs
//=========================
pivotLen = input.int(5, "Pivot Length", minval = 1)

//=========================
// Pivot Detection
//=========================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// Variables & State Tracking
//=========================
var int activeTrend = 0 // 1 = Accumulating Up, -1 = Accumulating Down, 0 = Initializing
var float cumVol = 0.0

var float startPrice = na
var int startBar = na

var int lastEndBar = na
var float lastEndPrice = na

// Historical trackers for previous moves to perform momentum math
var float prevUpVol = na
var float prevUpLen = na
var float prevDownVol = na
var float prevDownLen = na

//=========================
// 1. COMPLETE ACTIVE MOVES & INSTANTLY HANDOFF
//=========================

if activeTrend == 1 and not na(ph)
    endPrice = ph
    endBar = bar_index - pivotLen
    
    priceLength = math.abs(endPrice - startPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    // Calculate momentum and create comparative strings
    float expectedMove = na
    string calcStr = "\nExp: N/A"
    
    if not na(prevUpVol) and prevUpVol > 0
        expectedMove := (prevUpLen * cumVol) / prevUpVol
        calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct: " + str.tostring(priceLength, "#.##")
        
        // Signal trigger if underperformed
        if priceLength < expectedMove
            label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

    // Structural Box
    box.new(left=startBar, top=endPrice, right=endBar, bottom=startPrice, bgcolor=color.new(color.green, 100), border_color=color.new(color.green, 40))

    // Data label pushed vertically outside/below the box
    label.new(x=midBar, y=na, 
         text="V: " + str.tostring(cumVol, format.volume) + 
              "\nL: " + str.tostring(priceLength, "#.##") + 
              "\nB: " + str.tostring(barCount) + calcStr, 
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 100), textcolor=color.green, size=size.small)

    // Store current values as historical baseline for next up trend
    prevUpVol := cumVol
    prevUpLen := priceLength

    // --- REFINED SEAMLESS HANDOFF ---
    // The moment the Up Trend ends on this Pivot High, a Down Trend begins from this exact point.
    // We calculate the volume accumulated since the pivot occurred (last 5 bars) and pass it to the new trend.
    lastEndBar := endBar
    lastEndPrice := endPrice
    
    activeTrend := -1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

if activeTrend == -1 and not na(pl)
    endPrice = pl
    endBar = bar_index - pivotLen
    
    priceLength = math.abs(startPrice - endPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    // Calculate momentum and create comparative strings
    float expectedMove = na
    string calcStr = "\nExp: N/A"

    if not na(prevDownVol) and prevDownVol > 0
        expectedMove := (prevDownLen * cumVol) / prevDownVol
        calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct: " + str.tostring(priceLength, "#.##")
        
        // Signal trigger if underperformed
        if priceLength < expectedMove
            label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

    // Structural Box
    box.new(left=startBar, top=startPrice, right=endBar, bottom=endPrice, bgcolor=color.new(color.red, 100), border_color=color.new(color.red, 40))

    // Data label pushed vertically outside/below the box
    label.new(x=midBar, y=na, 
         text="V: " + str.tostring(cumVol, format.volume) + 
              "\nL: " + str.tostring(priceLength, "#.##") + 
              "\nB: " + str.tostring(barCount) + calcStr, 
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.red, 100), textcolor=color.red, size=size.small)

    // Store current values as historical baseline for next down trend
    prevDownVol := cumVol
    prevDownLen := priceLength

    // --- REFINED SEAMLESS HANDOFF ---
    // The moment the Down Trend ends on this Pivot Low, an Up Trend begins from this exact point.
    // We calculate the volume accumulated since the pivot occurred (last 5 bars) and pass it to the new trend.
    lastEndBar := endBar
    lastEndPrice := endPrice
    
    activeTrend := 1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

//=========================
// 2. INITIALIZATION ROUTINE (Only runs once at start of history)
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]

//=========================
// 3. ACCUMULATE VOLUME
//=========================
// If a trend is actively running and no new opposing pivot has confirmed on this bar, 
// add the current bar's volume to the tally.
else
    cumVol += volume