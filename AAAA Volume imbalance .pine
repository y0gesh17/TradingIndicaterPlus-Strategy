//@version=5
strategy("Trend Volume & Price Momentum (Alpha Engine - SL & TP)", overlay = true, max_boxes_count = 500, max_labels_count = 500, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

//=========================
// Inputs
//=========================
pivotLen          = input.int(5, "Pivot Length", minval = 1)
smoothingLen      = input.int(4, "History Smoothing Length (Boxes)", minval = 1, tooltip = "Smooths out single-box volume/height anomalies.")
atrLen            = input.int(14, "ATR Volatility Length")
atrMult           = input.float(1.5, "ATR Threshold Multiplier")
filterWeekend     = input.bool(false, "Filter Out Weekend Signals?")

// --- VOLUME IMBALANCE INPUTS ---
enableVolImbalance = input.bool(true, "Enable Box Volume Imbalance Filter", group = "Volume Imbalance Engine")
volRatioThreshold  = input.float(1.8, "Volume Multiplier Threshold (x Prev Box)", minval = 1.0, step = 0.1, group = "Volume Imbalance Engine")

//=========================
// Market Variables & Filters
//=========================
isWeekend = dayofweek(time) == 7 or dayofweek(time) == 1
allowSignal = not filterWeekend or not isWeekend
atr = ta.atr(atrLen)
alpha = 2.0 / (smoothingLen + 1)

// Pivot Detection
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// State Tracking Variables
//=========================
var int activeTrend = 0
var float cumVol = 0.0
var float prevBoxVol = na // Track volume of the prior box
var float startPrice = na
var int startBar = na

// Smoothed efficiency baselines
var float smoothUpEff = na
var float smoothDownEff = na

// Extreme boundary trackers and their locations
var float maxHigh = high
var float minLow = low
var int maxHighBar = na
var int minLowBar = na

//=========================
// PERSISTENT LIVE DRAWING TRACKERS
//=========================
var box liveBox = na
var label liveLabel = na

if not na(liveBox)
    box.delete(liveBox)
if not na(liveLabel)
    label.delete(liveLabel)

//=========================
// 1. COMPLETE ACTIVE MOVES & HANDOFF VIA PIVOTS
//=========================
if activeTrend == 1 and not na(ph)
    int endBar = bar_index - pivotLen
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    float expectedMove = na

    // Volume Imbalance Check (1.8x prior box volume)
    bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol[pivotLen] >= prevBoxVol * volRatioThreshold)

    if not na(smoothUpEff)
        expectedMove := smoothUpEff * cumVol[pivotLen]
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        if expGreaterThanAct and volImbalancePass and allowSignal
            label.new(x=endBar, y=na, text="▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
            strategy.entry("Sell", strategy.short)

    string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
    string boxTxt = "V: " + str.tostring(cumVol[pivotLen], format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.green, 92), border_color=color.new(color.green, 40))
    label.new(x=math.round((startBar + endBar) / 2), y=maxHigh[pivotLen], text=boxTxt, color=color.new(color.green, 90), textcolor=color.green, style=label.style_label_down, size=size.small)

    float currentEff = totalBoxHeight / (cumVol[pivotLen] > 0 ? cumVol[pivotLen] : 1.0)
    smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

    // Save completed box volume for next box comparison
    prevBoxVol := cumVol[pivotLen]

    activeTrend := -1
    startPrice := ph
    startBar := endBar
    maxHigh := high
    minLow := low
    maxHighBar := bar_index
    minLowBar := bar_index
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        if high[i] > maxHigh
            maxHigh := high[i]
            maxHighBar := bar_index - i
        if low[i] < minLow
            minLow := low[i]
            minLowBar := bar_index - i

if activeTrend == -1 and not na(pl)
    int endBar = bar_index - pivotLen
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    float expectedMove = na

    // Volume Imbalance Check (1.8x prior box volume)
    bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol[pivotLen] >= prevBoxVol * volRatioThreshold)

    if not na(smoothDownEff)
        expectedMove := smoothDownEff * cumVol[pivotLen]
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        if expGreaterThanAct and volImbalancePass and allowSignal
            label.new(x=endBar, y=na, text="▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            strategy.entry("Buy", strategy.long)

    string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
    string boxTxt = "V: " + str.tostring(cumVol[pivotLen], format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.red, 92), border_color=color.new(color.red, 40))
    label.new(x=math.round((startBar + endBar) / 2), y=minLow[pivotLen], text=boxTxt, color=color.new(color.red, 90), textcolor=color.red, style=label.style_label_up, size=size.small)

    float currentEff = totalBoxHeight / (cumVol[pivotLen] > 0 ? cumVol[pivotLen] : 1.0)
    smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

    // Save completed box volume for next box comparison
    prevBoxVol := cumVol[pivotLen]

    activeTrend := 1
    startPrice := pl
    startBar := endBar
    maxHigh := high
    minLow := low
    maxHighBar := bar_index
    minLowBar := bar_index
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        if high[i] > maxHigh
            maxHigh := high[i]
            maxHighBar := bar_index - i
        if low[i] < minLow
            minLow := low[i]
            minLowBar := bar_index - i

//=========================
// 2. INITIALIZATION ROUTINE
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index
        for i = 0 to pivotLen
            cumVol += volume[i]
            if high[i] > maxHigh
                maxHigh := high[i]
                maxHighBar := bar_index - i
            if low[i] < minLow
                minLow := low[i]
                minLowBar := bar_index - i
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index
        for i = 0 to pivotLen
            cumVol += volume[i]
            if high[i] > maxHigh
                maxHigh := high[i]
                maxHighBar := bar_index - i
            if low[i] < minLow
                minLow := low[i]
                minLowBar := bar_index - i

//=========================
// 3. ACCUMULATE VOLUME & INVALIDATIONS
//=========================
else
    cumVol += volume
    
    if high > maxHigh
        maxHigh := high
        maxHighBar := bar_index
    if low < minLow
        minLow := low
        minLowBar := bar_index

    // --- STRUCTURAL BREAKOUT / INVALIDATION DETECTOR ---
    if activeTrend == -1 and high > startPrice
        int endBar = bar_index
        float totalBoxHeight = maxHigh - minLow
        
        bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol >= prevBoxVol * volRatioThreshold)
        float expectedMove = not na(smoothDownEff) ? smoothDownEff * cumVol : na
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        
        if expGreaterThanAct and volImbalancePass and allowSignal
            label.new(x=endBar, y=na, text="▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            strategy.entry("Buy", strategy.long)

        string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
        string boxTxt = "V: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

        box.new(left=startBar, top=maxHigh, right=endBar, bottom=minLow, bgcolor=color.new(color.red, 92), border_color=color.new(color.red, 40))
        label.new(x=math.round((startBar + endBar) / 2), y=minLow, text=boxTxt, color=color.new(color.red, 90), textcolor=color.red, style=label.style_label_up, size=size.small)

        float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

        prevBoxVol := cumVol

        activeTrend := 1
        startPrice := minLow
        startBar := na(minLowBar) ? bar_index : minLowBar
        cumVol := 0.0
        maxHigh := high
        minLow := startPrice
        maxHighBar := bar_index
        minLowBar := bar_index
        
        int limit = bar_index - startBar
        if limit >= 0
            for i = limit to 0
                cumVol += volume[i]
                maxHigh := math.max(maxHigh, high[i])
                minLow := math.min(minLow, low[i])
                    
    else if activeTrend == 1 and low < startPrice
        int endBar = bar_index
        float totalBoxHeight = maxHigh - minLow
        
        bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol >= prevBoxVol * volRatioThreshold)
        float expectedMove = not na(smoothUpEff) ? smoothUpEff * cumVol : na
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        
        if expGreaterThanAct and volImbalancePass and allowSignal
            label.new(x=endBar, y=na, text="▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
            strategy.entry("Sell", strategy.short)

        string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
        string boxTxt = "V: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

        box.new(left=startBar, top=maxHigh, right=endBar, bottom=minLow, bgcolor=color.new(color.green, 92), border_color=color.new(color.green, 40))
        label.new(x=math.round((startBar + endBar) / 2), y=maxHigh, text=boxTxt, color=color.new(color.green, 90), textcolor=color.green, style=label.style_label_up, size=size.small)

        float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

        prevBoxVol := cumVol

        activeTrend := -1
        startPrice := maxHigh
        startBar := na(maxHighBar) ? bar_index : maxHighBar
        cumVol := 0.0
        maxHigh := startPrice
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index

        int limit = bar_index - startBar
        if limit >= 0
            for i = limit to 0
                cumVol += volume[i]
                maxHigh := math.max(maxHigh, high[i])
                minLow := math.min(minLow, low[i])

//=========================
// 4. LIVE ENGINE & REAL-TIME PRE-SIGNAL LAYER
//=========================
if activeTrend != 0
    bool liveIsUp = (activeTrend == 1)
    float liveTotalBoxHeight = maxHigh - minLow
    float liveExpectedMove = na
    
    if liveIsUp and not na(smoothUpEff)
        liveExpectedMove := smoothUpEff * cumVol
    else if not liveIsUp and not na(smoothDownEff)
        liveExpectedMove := smoothDownEff * cumVol
    
    float ratioVsPrev = not na(prevBoxVol) and prevBoxVol > 0 ? (cumVol / prevBoxVol) : na
    string ratioStr = not na(ratioVsPrev) ? str.tostring(ratioVsPrev, "#.##") + "x" : "N/A"

    string liveExpStr = not na(liveExpectedMove) ? str.tostring(liveExpectedMove, "#.##") : "N/A"
    string liveBoxTxt = "Vol Ratio vs Prev: " + ratioStr + "\nV: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(liveTotalBoxHeight, "#.##") + "\nExp H: " + liveExpStr
            
    color liveColor = liveIsUp ? color.green : color.red
    
    liveBox := box.new(left=startBar, top=maxHigh, right=bar_index, bottom=minLow, bgcolor=color.new(liveColor, 95), border_color=color.new(liveColor, 50), border_style=line.style_dashed)
    liveLabel := label.new(x=math.round((startBar + bar_index) / 2), y=liveIsUp ? maxHigh : minLow, text=liveBoxTxt, color=color.new(liveColor, 90), textcolor=liveColor, style=liveIsUp ? label.style_label_down : label.style_label_up, size=size.small)

//=========================
// 5. STOP LOSS & TAKE PROFIT MANAGEMENT
//=========================
if strategy.position_size > 0
    strategy.exit("Exit Long", "Buy", stop = strategy.position_avg_price * 0.99, limit = strategy.position_avg_price * 3.5)
else if strategy.position_size < 0
    strategy.exit("Exit Short", "Sell", stop = strategy.position_avg_price * 1.01, limit = strategy.position_avg_price / 3.5)




    //new 


    //@version=5
strategy("Trend Volume & Price Momentum (Alpha Engine - SL & TP)", overlay = true, max_boxes_count = 500, max_labels_count = 500, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

//=========================
// Inputs
//=========================
pivotLen          = input.int(5, "Pivot Length", minval = 1)
smoothingLen      = input.int(4, "History Smoothing Length (Boxes)", minval = 1, tooltip = "Smooths out single-box volume/height anomalies.")
atrLen            = input.int(14, "ATR Volatility Length")
atrMult           = input.float(1.5, "ATR Threshold Multiplier")
filterWeekend     = input.bool(false, "Filter Out Weekend Signals?")

// --- VOLUME IMBALANCE INPUTS ---
enableVolImbalance = input.bool(true, "Enable Box Volume Imbalance Filter", group = "Volume Imbalance Engine")
volRatioThreshold  = input.float(1.8, "Volume Multiplier Threshold (x Prev Box)", minval = 1.0, step = 0.1, group = "Volume Imbalance Engine")

//=========================
// Market Variables & Filters
//=========================
isWeekend = dayofweek(time) == 7 or dayofweek(time) == 1
allowSignal = not filterWeekend or not isWeekend
atr = ta.atr(atrLen)
alpha = 2.0 / (smoothingLen + 1)

// Pivot Detection
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// State Tracking Variables
//=========================
var int activeTrend = 0
var float cumVol = 0.0
var float prevBoxVol = na // Track volume of the prior box
var float startPrice = na
var int startBar = na

// Smoothed efficiency baselines
var float smoothUpEff = na
var float smoothDownEff = na

// Extreme boundary trackers and their locations
var float maxHigh = high
var float minLow = low
var int maxHighBar = na
var int minLowBar = na

//=========================
// PERSISTENT LIVE DRAWING TRACKERS
//=========================
var box liveBox = na
var label liveLabel = na

if not na(liveBox)
    box.delete(liveBox)
if not na(liveLabel)
    label.delete(liveLabel)

// Check if flat (no active positions open)
noOpenPosition = strategy.position_size == 0

//=========================
// 1. COMPLETE ACTIVE MOVES & HANDOFF VIA PIVOTS
//=========================
if activeTrend == 1 and not na(ph)
    int endBar = bar_index - pivotLen
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    float expectedMove = na

    // Volume Imbalance Check (1.8x prior box volume)
    bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol[pivotLen] >= prevBoxVol * volRatioThreshold)

    if not na(smoothUpEff)
        expectedMove := smoothUpEff * cumVol[pivotLen]
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        // Check no existing open position before entering
        if expGreaterThanAct and volImbalancePass and allowSignal and noOpenPosition
            label.new(x=endBar, y=na, text="▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
            strategy.entry("Sell", strategy.short)

    string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
    string boxTxt = "V: " + str.tostring(cumVol[pivotLen], format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.green, 92), border_color=color.new(color.green, 40))
    label.new(x=math.round((startBar + endBar) / 2), y=maxHigh[pivotLen], text=boxTxt, color=color.new(color.green, 90), textcolor=color.green, style=label.style_label_down, size=size.small)

    float currentEff = totalBoxHeight / (cumVol[pivotLen] > 0 ? cumVol[pivotLen] : 1.0)
    smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

    // Save completed box volume for next box comparison
    prevBoxVol := cumVol[pivotLen]

    activeTrend := -1
    startPrice := ph
    startBar := endBar
    maxHigh := high
    minLow := low
    maxHighBar := bar_index
    minLowBar := bar_index
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        if high[i] > maxHigh
            maxHigh := high[i]
            maxHighBar := bar_index - i
        if low[i] < minLow
            minLow := low[i]
            minLowBar := bar_index - i

if activeTrend == -1 and not na(pl)
    int endBar = bar_index - pivotLen
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    float expectedMove = na

    // Volume Imbalance Check (1.8x prior box volume)
    bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol[pivotLen] >= prevBoxVol * volRatioThreshold)

    if not na(smoothDownEff)
        expectedMove := smoothDownEff * cumVol[pivotLen]
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        // Check no existing open position before entering
        if expGreaterThanAct and volImbalancePass and allowSignal and noOpenPosition
            label.new(x=endBar, y=na, text="▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            strategy.entry("Buy", strategy.long)

    string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
    string boxTxt = "V: " + str.tostring(cumVol[pivotLen], format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.red, 92), border_color=color.new(color.red, 40))
    label.new(x=math.round((startBar + endBar) / 2), y=minLow[pivotLen], text=boxTxt, color=color.new(color.red, 90), textcolor=color.red, style=label.style_label_up, size=size.small)

    float currentEff = totalBoxHeight / (cumVol[pivotLen] > 0 ? cumVol[pivotLen] : 1.0)
    smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

    // Save completed box volume for next box comparison
    prevBoxVol := cumVol[pivotLen]

    activeTrend := 1
    startPrice := pl
    startBar := endBar
    maxHigh := high
    minLow := low
    maxHighBar := bar_index
    minLowBar := bar_index
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        if high[i] > maxHigh
            maxHigh := high[i]
            maxHighBar := bar_index - i
        if low[i] < minLow
            minLow := low[i]
            minLowBar := bar_index - i

//=========================
// 2. INITIALIZATION ROUTINE
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index
        for i = 0 to pivotLen
            cumVol += volume[i]
            if high[i] > maxHigh
                maxHigh := high[i]
                maxHighBar := bar_index - i
            if low[i] < minLow
                minLow := low[i]
                minLowBar := bar_index - i
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index
        for i = 0 to pivotLen
            cumVol += volume[i]
            if high[i] > maxHigh
                maxHigh := high[i]
                maxHighBar := bar_index - i
            if low[i] < minLow
                minLow := low[i]
                minLowBar := bar_index - i

//=========================
// 3. ACCUMULATE VOLUME & INVALIDATIONS
//=========================
else
    cumVol += volume
    
    if high > maxHigh
        maxHigh := high
        maxHighBar := bar_index
    if low < minLow
        minLow := low
        minLowBar := bar_index

    // --- STRUCTURAL BREAKOUT / INVALIDATION DETECTOR ---
    if activeTrend == -1 and high > startPrice
        int endBar = bar_index
        float totalBoxHeight = maxHigh - minLow
        
        bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol >= prevBoxVol * volRatioThreshold)
        float expectedMove = not na(smoothDownEff) ? smoothDownEff * cumVol : na
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        
        // Check no existing open position before entering
        if expGreaterThanAct and volImbalancePass and allowSignal and noOpenPosition
            label.new(x=endBar, y=na, text="▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            strategy.entry("Buy", strategy.long)

        string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
        string boxTxt = "V: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

        box.new(left=startBar, top=maxHigh, right=endBar, bottom=minLow, bgcolor=color.new(color.red, 92), border_color=color.new(color.red, 40))
        label.new(x=math.round((startBar + endBar) / 2), y=minLow, text=boxTxt, color=color.new(color.red, 90), textcolor=color.red, style=label.style_label_up, size=size.small)

        float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

        prevBoxVol := cumVol

        activeTrend := 1
        startPrice := minLow
        startBar := na(minLowBar) ? bar_index : minLowBar
        cumVol := 0.0
        maxHigh := high
        minLow := startPrice
        maxHighBar := bar_index
        minLowBar := bar_index
        
        int limit = bar_index - startBar
        if limit >= 0
            for i = limit to 0
                cumVol += volume[i]
                maxHigh := math.max(maxHigh, high[i])
                minLow := math.min(minLow, low[i])
                    
    else if activeTrend == 1 and low < startPrice
        int endBar = bar_index
        float totalBoxHeight = maxHigh - minLow
        
        bool volImbalancePass = not enableVolImbalance or na(prevBoxVol) or (cumVol >= prevBoxVol * volRatioThreshold)
        float expectedMove = not na(smoothUpEff) ? smoothUpEff * cumVol : na
        bool expGreaterThanAct = not na(expectedMove) and (expectedMove > totalBoxHeight)
        
        // Check no existing open position before entering
        if expGreaterThanAct and volImbalancePass and allowSignal and noOpenPosition
            label.new(x=endBar, y=na, text="▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
            strategy.entry("Sell", strategy.short)

        string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
        string boxTxt = "V: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

        box.new(left=startBar, top=maxHigh, right=endBar, bottom=minLow, bgcolor=color.new(color.green, 92), border_color=color.new(color.green, 40))
        label.new(x=math.round((startBar + endBar) / 2), y=maxHigh, text=boxTxt, color=color.new(color.green, 90), textcolor=color.green, style=label.style_label_up, size=size.small)

        float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

        prevBoxVol := cumVol

        activeTrend := -1
        startPrice := maxHigh
        startBar := na(maxHighBar) ? bar_index : maxHighBar
        cumVol := 0.0
        maxHigh := startPrice
        minLow := low
        maxHighBar := bar_index
        minLowBar := bar_index

        int limit = bar_index - startBar
        if limit >= 0
            for i = limit to 0
                cumVol += volume[i]
                maxHigh := math.max(maxHigh, high[i])
                minLow := math.min(minLow, low[i])

//=========================
// 4. LIVE ENGINE & REAL-TIME PRE-SIGNAL LAYER
//=========================
if activeTrend != 0
    bool liveIsUp = (activeTrend == 1)
    float liveTotalBoxHeight = maxHigh - minLow
    float liveExpectedMove = na
    
    if liveIsUp and not na(smoothUpEff)
        liveExpectedMove := smoothUpEff * cumVol
    else if not liveIsUp and not na(smoothDownEff)
        liveExpectedMove := smoothDownEff * cumVol
    
    float ratioVsPrev = not na(prevBoxVol) and prevBoxVol > 0 ? (cumVol / prevBoxVol) : na
    string ratioStr = not na(ratioVsPrev) ? str.tostring(ratioVsPrev, "#.##") + "x" : "N/A"

    string liveExpStr = not na(liveExpectedMove) ? str.tostring(liveExpectedMove, "#.##") : "N/A"
    string liveBoxTxt = "Vol Ratio vs Prev: " + ratioStr + "\nV: " + str.tostring(cumVol, format.volume) + "\nAct H: " + str.tostring(liveTotalBoxHeight, "#.##") + "\nExp H: " + liveExpStr
            
    color liveColor = liveIsUp ? color.green : color.red
    
    liveBox := box.new(left=startBar, top=maxHigh, right=bar_index, bottom=minLow, bgcolor=color.new(liveColor, 95), border_color=color.new(liveColor, 50), border_style=line.style_dashed)
    liveLabel := label.new(x=math.round((startBar + bar_index) / 2), y=liveIsUp ? maxHigh : minLow, text=liveBoxTxt, color=color.new(liveColor, 90), textcolor=liveColor, style=liveIsUp ? label.style_label_down : label.style_label_up, size=size.small)

//=========================
// 5. STOP LOSS & TAKE PROFIT MANAGEMENT (1.5% Risk : 4.5% Reward)
//=========================
if strategy.position_size > 0
    // Long Exit: 1.5% Stop Loss, 4.5% Take Profit
    strategy.exit("Exit Long", "Buy", stop = strategy.position_avg_price * 0.985, limit = strategy.position_avg_price * 1.045)
else if strategy.position_size < 0
    // Short Exit: 1.5% Stop Loss, 4.5% Take Profit
    strategy.exit("Exit Short", "Sell", stop = strategy.position_avg_price * 1.015, limit = strategy.position_avg_price * 0.955)