//@version=5
indicator("Trend Volume & Price Momentum (Alpha Engine - Total Height)", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//=========================
// Inputs
//=========================
pivotLen     = input.int(5, "Pivot Length", minval = 1)
smoothingLen = input.int(4, "History Smoothing Length (Boxes)", minval = 1, tooltip = "Smooths out single-box volume/height anomalies.")
atrLen       = input.int(14, "ATR Volatility Length")
atrMult      = input.float(1.5, "ATR Threshold Multiplier", tooltip = "Replaces fixed point limits with dynamic volatility ranges.")
filterWeekend= input.bool(false, "Filter Out Weekend Signals?")

//=========================
// Market Variables & Filters
//=========================
isWeekend = dayofweek(time) == 7 or dayofweek(time) == 1
allowSignal = not filterWeekend or not isWeekend
atr = ta.atr(atrLen)
alpha = 2.0 / (smoothingLen + 1) // EMA smoothing multiplier for box history

// Pivot Detection
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// State Tracking Variables
//=========================
var int activeTrend = 0 // 1 = Up, -1 = Down, 0 = Init
var float cumVol = 0.0
var float startPrice = na
var int startBar = na

// Smoothed efficiency baselines (Total Height / Volume)
var float smoothUpEff = na
var float smoothDownEff = na

// Extreme boundary trackers inside the current box structure
var float maxHigh = high
var float minLow = low

//=========================
// PERSISTENT LIVE DRAWING TRACKERS
//=========================
var box liveBox = na
var label liveLabel = na

// Instantly purge real-time instances from the previous tick to avoid memory leaks
if not na(liveBox)
    box.delete(liveBox)
if not na(liveLabel)
    label.delete(liveLabel)

//=========================
// 1. COMPLETE ACTIVE MOVES & INSTANTLY HANDOFF
//=========================
if activeTrend == 1 and not na(ph)
    endPrice = ph
    endBar = bar_index - pivotLen
    
    // Calculate total box height (Extreme High to Extreme Low)
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    
    int barCount = endBar - startBar + 1
    int midBar = int(math.floor((startBar + endBar) / 2))

    float expectedMove = na
    string calcStr = "\nExp: N/A"
    
    if not na(smoothUpEff)
        expectedMove := smoothUpEff * cumVol
        calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct (Height): " + str.tostring(totalBoxHeight, "#.##")
        
        // Volatility Dynamic Threshold Check using Total Height
        if not na(expectedMove) and expectedMove >= totalBoxHeight + (atrMult * atr[pivotLen]) and allowSignal
            label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.green, 100), border_color=color.new(color.green, 40))

    string reportTxt = "V: " + str.tostring(cumVol, format.volume) + "\nH (Total Height): " + str.tostring(totalBoxHeight, "#.##") + "\nB: " + str.tostring(barCount) + calcStr
    label.new(x=midBar, y=na, text=reportTxt, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 100), textcolor=color.green, size=size.small)

    // Smooth current efficiency baseline into historical memory
    float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
    smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

    // Hand off configurations to the next down sequence
    activeTrend := -1
    startPrice := endPrice
    startBar := endBar
    maxHigh := high
    minLow := low
    
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        maxHigh := math.max(maxHigh, high[i])
        minLow := math.min(minLow, low[i])

if activeTrend == -1 and not na(pl)
    endPrice = pl
    endBar = bar_index - pivotLen
    
    // Calculate total box height (Extreme High to Extreme Low)
    float totalBoxHeight = maxHigh[pivotLen] - minLow[pivotLen]
    
    int barCount = endBar - startBar + 1
    int midBar = int(math.floor((startBar + endBar) / 2))

    float expectedMove = na
    string calcStr = "\nExp: N/A"

    if not na(smoothDownEff)
        expectedMove := smoothDownEff * cumVol
        calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct (Height): " + str.tostring(totalBoxHeight, "#.##")
        
        // Volatility Dynamic Threshold Check using Total Height
        if not na(expectedMove) and expectedMove >= totalBoxHeight + (atrMult * atr[pivotLen]) and allowSignal
            label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

    box.new(left=startBar, top=maxHigh[pivotLen], right=endBar, bottom=minLow[pivotLen], bgcolor=color.new(color.red, 100), border_color=color.new(color.red, 40))

    string reportTxt = "V: " + str.tostring(cumVol, format.volume) + "\nH (Total Height): " + str.tostring(totalBoxHeight, "#.##") + "\nB: " + str.tostring(barCount) + calcStr
    label.new(x=midBar, y=na, text=reportTxt, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.red, 100), textcolor=color.red, size=size.small)

    // Smooth current efficiency baseline into historical memory
    float currentEff = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
    smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

    // Hand off configurations to the next up sequence
    activeTrend := 1
    startPrice := endPrice
    startBar := endBar
    maxHigh := high
    minLow := low
    
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]
        maxHigh := math.max(maxHigh, high[i])
        minLow := math.min(minLow, low[i])

//=========================
// 2. INITIALIZATION ROUTINE
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        for i = 0 to pivotLen
            cumVol += volume[i]
            maxHigh := math.max(maxHigh, high[i])
            minLow := math.min(minLow, low[i])
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        cumVol := 0.0
        maxHigh := high
        minLow := low
        for i = 0 to pivotLen
            cumVol += volume[i]
            maxHigh := math.max(maxHigh, high[i])
            minLow := math.min(minLow, low[i])

//=========================
// 3. ACCUMULATE VOLUME & BOUNDARIES
//=========================
else
    cumVol += volume
    maxHigh := math.max(maxHigh, high)
    minLow := math.min(minLow, low)

//=========================
// 4. LIVE ENGINE & REAL-TIME PRE-SIGNAL LAYER
//=========================
if activeTrend != 0
    bool liveIsUp = (activeTrend == 1)
    float liveTotalBoxHeight = maxHigh - minLow
    int liveBarCount = bar_index - startBar + 1
    int liveMidBar = int(math.floor((startBar + bar_index) / 2))
    
    float liveExpectedMove = na
    string liveCalcStr = "\nExp: N/A"
    bool preSignalTriggered = false
    
    if liveIsUp and not na(smoothUpEff)
        liveExpectedMove := smoothUpEff * cumVol
        liveCalcStr := "\nExp: " + str.tostring(liveExpectedMove, "#.##") + "\nAct (Height): " + str.tostring(liveTotalBoxHeight, "#.##")
        preSignalTriggered := (liveExpectedMove >= liveTotalBoxHeight + (atrMult * atr))
    else if not liveIsUp and not na(smoothDownEff)
        liveExpectedMove := smoothDownEff * cumVol
        liveCalcStr := "\nExp: " + str.tostring(liveExpectedMove, "#.##") + "\nAct (Height): " + str.tostring(liveTotalBoxHeight, "#.##")
        preSignalTriggered := (liveExpectedMove >= liveTotalBoxHeight + (atrMult * atr))
            
    color liveColor = liveIsUp ? color.green : color.red
    
    // Render dynamic real-time dashed box boundaries using live extremes
    liveBox := box.new(left=startBar, top=maxHigh, right=bar_index, bottom=minLow, bgcolor=color.new(liveColor, 96), border_color=color.new(liveColor, 50), border_style=line.style_dashed)
    
    // Visual alert modification to the live tracking label if an anomaly forms mid-bar
    string alertPrefix = preSignalTriggered ? "⚠️ [EXHAUSTION ANOMALY] " : "[LIVE] "
    string liveTxt = alertPrefix + "V: " + str.tostring(cumVol, format.volume) + "\nH (Total Height): " + str.tostring(liveTotalBoxHeight, "#.##") + "\nB: " + str.tostring(liveBarCount) + liveCalcStr
    
    liveLabel := label.new(x=liveMidBar, y=na, text=liveTxt, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(liveColor, 100), textcolor=liveColor, size=size.small)