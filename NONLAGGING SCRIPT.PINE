//@version=5
indicator("Zero-Lag Trend Volume & Efficiency Model", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//=========================
// Inputs
//=========================
trendPeriod    = input.int(5, "Trend Sensitivity (Donchian Period)", minval = 2)
historyLength  = input.int(5, "History Length (N)", minval = 1)

//=========================
// Zero-Lag Trend Detection Logic
//=========================
// We use the highest high and lowest low of the trailing periods to create immediate breakout triggers
trailingHigh = ta.highest(high, trendPeriod)[1]
trailingLow  = ta.lowest(low, trendPeriod)[1]

var int activeTrend = 0 // 1 = Up Trend running, -1 = Down Trend running, 0 = Waiting
var float cumVol = 0.0

var float startPrice = na
var int startBar = na

var int lastEndBar = na
var float lastEndPrice = na

// Array queues to track historical efficiencies
var float[] upHistory   = array.new_float(0)
var float[] downHistory = array.new_float(0)

// Detect immediate transitions
switchUp   = (activeTrend <= 0 and high > trailingHigh)
switchDown = (activeTrend >= 0 and low < trailingLow)

//=========================
// Helper Functions
//=========================
updateHistory(float[] histArray, float newValue, int maxLen) =>
    array.push(histArray, newValue)
    if array.size(histArray) > maxLen
        array.shift(histArray)

getStatsAndColor(float currentVol, float actualLen, float[] histArray, int maxLen) =>
    float efficiency = currentVol > 0 ? actualLen / currentVol : na
    if not na(efficiency)
        updateHistory(histArray, efficiency, maxLen)
        
    float sumEff = 0.0
    int validCount = 0
    int histSize = array.size(histArray)
    
    if histSize > 1
        for i = 0 to histSize - 2
            sumEff += array.get(histArray, i)
            validCount += 1
            
    float avgEfficiency = validCount > 0 ? sumEff / validCount : na
    float expectedLen = not na(avgEfficiency) ? avgEfficiency * currentVol : na
    float confidence = (not na(expectedLen) and expectedLen > 0) ? actualLen / expectedLen : na
    float volPerPoint = actualLen > 0 ? currentVol / actualLen : na
    
    color textCol = color.gray
    if not na(confidence)
        if confidence >= 1.20
            textCol := color.rgb(0, 100, 0)
        else if confidence >= 1.00
            textCol := color.green
        else if confidence >= 0.80
            textCol := color.orange
        else
            textCol := color.red
            
    [expStr, confStr, vppStr] = array.create_string(3, "")
    expStr  := not na(expectedLen) ? str.tostring(expectedLen, "#.##") : "N/A"
    confStr := not na(confidence)  ? str.tostring(confidence, "#.##")  : "N/A"
    vppStr  := not na(volPerPoint)  ? str.tostring(volPerPoint, format.volume) : "N/A"
    
    [expStr, confStr, vppStr, textCol, confidence]

//=========================
// 1. COMPLETE MOVES IMMEDIATELY ON BREAKOUT
//=========================

// If Up Trend is running and price breaks below trailing support -> Close it out instantly
if activeTrend == 1 and switchDown
    endPrice = close
    endBar = bar_index
    
    priceLength = math.abs(endPrice - startPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    [expStr, confStr, vppStr, labelColor, confidence] = getStatsAndColor(cumVol, priceLength, upHistory, historyLength)

    box.new(left=startBar, top=math.max(startPrice, endPrice), right=endBar, bottom=math.min(startPrice, endPrice), bgcolor=color.new(color.green, 100), border_color=color.new(color.green, 40))

    label.new(x=midBar, y=na, 
         text="V : " + str.tostring(cumVol, format.volume) + 
              "\nL : " + str.tostring(priceLength, "#.##") + 
              "\nB : " + str.tostring(barCount) + 
              "\nExp : " + expStr + 
              "\nConf : " + confStr + 
              "\nV/P : " + vppStr, 
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 100), textcolor=labelColor, size=size.small)

    if not na(confidence) and confidence < 0.80
        label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

    lastEndBar := endBar
    lastEndPrice := endPrice
    activeTrend := 0

// If Down Trend is running and price breaks above trailing resistance -> Close it out instantly
if activeTrend == -1 and switchUp
    endPrice = close
    endBar = bar_index
    
    priceLength = math.abs(startPrice - endPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    [expStr, confStr, vppStr, labelColor, confidence] = getStatsAndColor(cumVol, priceLength, downHistory, historyLength)

    box.new(left=startBar, top=math.max(startPrice, endPrice), right=endBar, bottom=math.min(startPrice, endPrice), bgcolor=color.new(color.red, 100), border_color=color.new(color.red, 40))

    label.new(x=midBar, y=na, 
         text="V : " + str.tostring(cumVol, format.volume) + 
              "\nL : " + str.tostring(priceLength, "#.##") + 
              "\nB : " + str.tostring(barCount) + 
              "\nExp : " + expStr + 
              "\nConf : " + confStr + 
              "\nV/P : " + vppStr, 
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.red, 100), textcolor=labelColor, size=size.small)

    if not na(confidence) and confidence < 0.80
        label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

    lastEndBar := endBar
    lastEndPrice := endPrice
    activeTrend := 0

//=========================
// 2. START NEW MOVES INSTANTLY
//=========================
if switchUp and activeTrend == 0
    activeTrend := 1
    cumVol := 0.0
    startPrice := not na(lastEndPrice) ? lastEndPrice : close[1]
    startBar   := not na(lastEndBar) ? lastEndBar : bar_index - 1

if switchDown and activeTrend == 0
    activeTrend := -1
    cumVol := 0.0
    startPrice := not na(lastEndPrice) ? lastEndPrice : close[1]
    startBar   := not na(lastEndBar) ? lastEndBar : bar_index - 1

//=========================
// 3. ACCUMULATE VOLUME
//=========================
if activeTrend != 0
    cumVol += volume

//=========================
// Visual Trailing Stop-Lines (Optional reference for chart visualization)
//=========================
plot(activeTrend == 1 ? trailingLow : na, color=color.new(color.green, 50), style=plot.style_linebr, title="Trailing Support")
plot(activeTrend == -1 ? trailingHigh : na, color=color.new(color.red, 50), style=plot.style_linebr, title="Trailing Resistance")