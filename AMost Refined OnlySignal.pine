//@version=5
indicator("Trend Momentum Signals Only", overlay = true, max_labels_count = 500)

//=========================
// Inputs
//=========================
pivotLen = input.int(5, "Pivot Length", minval = 1)

//=========================
// Weekend Detection Logic
//=========================
isWeekend = dayofweek(time) == 7 or dayofweek(time) == 1

//=========================
// Pivot Detection
//=========================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// Variables & State Tracking
//=========================
var int activeTrend = 0 // 1 = Accumulating Up, -1 = Accumulating Down, 0 = Initializing
var float cumVol = 0.0

var float startPrice = na
var int startBar = na

// Historical trackers for previous moves to perform momentum math
var float prevUpVol = na
var float prevUpLen = na
var float prevDownVol = na
var float prevDownLen = na

//=========================
// 1. COMPLETE ACTIVE MOVES & INSTANTLY HANDOFF
//=========================

if activeTrend == 1 and not na(ph)
    endPrice = ph
    endBar = bar_index - pivotLen
    priceLength = math.abs(endPrice - startPrice)
    
    if not na(prevUpVol) and prevUpVol > 0
        float expectedMove = (prevUpLen * cumVol) / prevUpVol
        
        // Signal trigger if expected is +20 points greater than actual value AND it is not the weekend
        if not na(expectedMove) and expectedMove >= priceLength + 20.0 and not isWeekend
            label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

    // Store current values as historical baseline for next up trend
    prevUpVol := cumVol
    prevUpLen := priceLength

    // Handoff to Down Trend
    activeTrend := -1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

if activeTrend == -1 and not na(pl)
    endPrice = pl
    endBar = bar_index - pivotLen
    priceLength = math.abs(startPrice - endPrice)

    if not na(prevDownVol) and prevDownVol > 0
        float expectedMove = (prevDownLen * cumVol) / prevDownVol
        
        // Signal trigger if expected is nearly greater than 1.5 time actual value AND it is not the weekend
        if not na(expectedMove) and expectedMove >= priceLength * 1.5 and not isWeekend
            label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

    // Store current values as historical baseline for next down trend
    prevDownVol := cumVol
    prevDownLen := priceLength

    // Handoff to Up Trend
    activeTrend := 1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

//=========================
// 2. INITIALIZATION ROUTINE
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]

//=========================
// 3. ACCUMULATE VOLUME
//=========================
else
    cumVol += volume