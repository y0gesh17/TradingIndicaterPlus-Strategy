//@version=5
indicator("Trend Volume & Price Momentum (Calculations & Combination Fixed)", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//=========================
// Inputs
//=========================
pivotLen      = input.int(5, "Pivot Length", minval = 1)
minMovePoints = input.float(20.0, "Minimum Box Length (Points)", minval = 0.0)

//=========================
// Pivot Detection
//=========================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

//=========================
// Variables & State Tracking
//=========================
var int activeTrend = 0 // 1 = Accumulating Up, -1 = Accumulating Down, 0 = Initializing
var float cumVol = 0.0

var float startPrice = na
var int startBar = na

// Multi-Box Merging Tracking Variables
var float visualStartPrice = na
var int visualStartBar = na
var string lastDirection = ""
var float mergedVol = 0.0

var int lastEndBar = na
var float lastEndPrice = na

// Historical trackers for previous moves to perform momentum math
var float prevUpVol = na
var float prevUpLen = na
var float prevDownVol = na
var float prevDownLen = na

//=========================
// 1. COMPLETE ACTIVE MOVES & INSTANTLY HANDOFF
//=========================

if activeTrend == 1 and not na(ph)
    endPrice = ph
    endBar = bar_index - pivotLen
    
    priceLength = math.abs(endPrice - startPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    // Determine current leg direction globally (critical for consecutive tracking)
    string currentDirection = endPrice >= startPrice ? "UP" : "DOWN"

    // Only process, calculate, signal, and draw if the move length is greater than 20 points
    if priceLength > minMovePoints
        // Calculate momentum and create comparative strings
        float expectedMove = na
        string calcStr = "\nExp: N/A"
        
        if not na(prevUpVol) and prevUpVol > 0
            expectedMove := (prevUpLen * cumVol) / prevUpVol
            calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct: " + str.tostring(priceLength, "#.##")
            
            // Signal Triggers
            if priceLength < expectedMove
                label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
            else if priceLength > expectedMove
                label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

        // If consecutive blocks match direction, merge them
        if currentDirection == lastDirection
            mergedVol += cumVol
        else
            visualStartPrice := startPrice
            visualStartBar := startBar
            mergedVol := cumVol

        color boxColor = currentDirection == "UP" ? color.green : color.red
        color textColor = currentDirection == "UP" ? color.green : color.red
        
        float displayLength = math.abs(endPrice - visualStartPrice)
        int displayBarCount = endBar - visualStartBar + 1
        int displayMidBar = math.floor((visualStartBar + endBar) / 2)

        // Combined/Structural Box
        box.new(left=visualStartBar, top=math.max(visualStartPrice, endPrice), right=endBar, bottom=math.min(visualStartPrice, endPrice), bgcolor=color.new(boxColor, 100), border_color=color.new(boxColor, 40))

        // Data label pushed vertically outside/below the box showing the accumulated calculation values
        label.new(x=displayMidBar, y=na, 
             text="V: " + str.tostring(mergedVol, format.volume) + 
                  "\nL: " + str.tostring(displayLength, "#.##") + 
                  "\nB: " + str.tostring(displayBarCount) + calcStr, 
             yloc=yloc.belowbar, style=label.style_label_up, color=color.new(boxColor, 100), textcolor=textColor, size=size.small)

        // Store current values as historical baseline for next up trend
        prevUpVol := cumVol
        prevUpLen := priceLength

    // Track the direction state REGARDLESS of whether the box met the 20 pt minimum requirement
    lastDirection := currentDirection

    // --- REFINED SEAMLESS HANDOFF ---
    lastEndBar := endBar
    lastEndPrice := endPrice
    
    activeTrend := -1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

if activeTrend == -1 and not na(pl)
    endPrice = pl
    endBar = bar_index - pivotLen
    
    priceLength = math.abs(startPrice - endPrice)
    barCount = endBar - startBar + 1
    midBar = math.floor((startBar + endBar) / 2)

    // Determine current leg direction globally (critical for consecutive tracking)
    string currentDirection = startPrice >= endPrice ? "DOWN" : "UP"

    // Only process, calculate, signal, and draw if the move length is greater than 20 points
    if priceLength > minMovePoints
        // Calculate momentum and create comparative strings
        float expectedMove = na
        string calcStr = "\nExp: N/A"

        if not na(prevDownVol) and prevDownVol > 0
            expectedMove := (prevDownLen * cumVol) / prevDownVol
            calcStr := "\nExp: " + str.tostring(expectedMove, "#.##") + "\nAct: " + str.tostring(priceLength, "#.##")
            
            // Signal Triggers
            if priceLength < expectedMove
                label.new(x=endBar, y=na, text="BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
            else if priceLength > expectedMove
                label.new(x=endBar, y=na, text="SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

        // If consecutive blocks match direction, merge them
        if currentDirection == lastDirection
            mergedVol += cumVol
        else
            visualStartPrice := startPrice
            visualStartBar := startBar
            mergedVol := cumVol

        color boxColor = currentDirection == "DOWN" ? color.red : color.green
        color textColor = currentDirection == "DOWN" ? color.red : color.green

        float displayLength = math.abs(visualStartPrice - endPrice)
        int displayBarCount = endBar - visualStartBar + 1
        int displayMidBar = math.floor((visualStartBar + endBar) / 2)

        // Combined/Structural Box
        box.new(left=visualStartBar, top=math.max(visualStartPrice, endPrice), right=endBar, bottom=math.min(visualStartPrice, endPrice), bgcolor=color.new(boxColor, 100), border_color=color.new(boxColor, 40))

        // Data label pushed vertically outside/below the box showing the accumulated calculation values
        label.new(x=displayMidBar, y=na, 
             text="V: " + str.tostring(mergedVol, format.volume) + 
                  "\nL: " + str.tostring(displayLength, "#.##") + 
                  "\nB: " + str.tostring(displayBarCount) + calcStr, 
             yloc=yloc.belowbar, style=label.style_label_up, color=color.new(boxColor, 100), textcolor=textColor, size=size.small)

        // Store current values as historical baseline for next down trend
        prevDownVol := cumVol
        prevDownLen := priceLength

    // Track the direction state REGARDLESS of whether the box met the 20 pt minimum requirement
    lastDirection := currentDirection

    // --- REFINED SEAMLESS HANDOFF ---
    lastEndBar := endBar
    lastEndPrice := endPrice
    
    activeTrend := 1
    startPrice := endPrice
    startBar := endBar
    
    // Recalculate historical volume from the pivot bar to the current bar
    cumVol := 0.0
    for i = 0 to pivotLen
        cumVol += volume[i]

//=========================
// 2. INITIALIZATION ROUTINE (Only runs once at start of history)
//=========================
if activeTrend == 0
    if not na(pl)
        activeTrend := 1
        startPrice := pl
        startBar := bar_index - pivotLen
        visualStartPrice := pl
        visualStartBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]
    else if not na(ph)
        activeTrend := -1
        startPrice := ph
        startBar := bar_index - pivotLen
        visualStartPrice := ph
        visualStartBar := bar_index - pivotLen
        cumVol := 0.0
        for i = 0 to pivotLen
            cumVol += volume[i]

//=========================
// 3. ACCUMULATE VOLUME
//=========================
else
    cumVol += volume