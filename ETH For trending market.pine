//@version=5
strategy("Trend Volume & Price Momentum (Risk-Managed v2)",
     overlay = true,
     max_boxes_count = 500,
     max_labels_count = 500,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 10000,
     margin_long = 10,                    // 10x leverage
     margin_short = 10)                   // 10x leverage

//=========================
// Inputs
//=========================
boxSize            = input.int(9, "Fixed Candle Count Per Box", minval = 1)
smoothingLen       = input.int(32, "History Smoothing Length (Boxes)", minval = 1)
filterWeekend      = input.bool(false, "Filter Out Weekend Signals?")

// --- POSITION SIZING (Updated for 10X Leverage Utilization) ---
useFullLeverage    = input.bool(true, "Use Full 10X Leverage Sizing?", group = "Position Sizing",
     tooltip = "When enabled, position size scales to utilize your full 10x margin capacity instead of a small risk percentage.")

// --- STOP / TARGET: fixed % or ATR-based ---
useAtrStops        = input.bool(true, "Use ATR-Based Stop/Target (instead of fixed %)", group = "Stop / Target")
atrLen             = input.int(14, "ATR Length", group = "Stop / Target")
atrStopMult        = input.float(1.5, "ATR Stop Multiple", minval = 0.1, step = 0.1, group = "Stop / Target")
atrTargetMult      = input.float(4.5, "ATR Target Multiple", minval = 0.1, step = 0.1, group = "Stop / Target")
fixedStopPct       = input.float(1.5, "Fixed Stop % (if ATR disabled)", minval = 0.1, step = 0.1, group = "Stop / Target")
fixedTargetPct     = input.float(4.5, "Fixed Target % (if ATR disabled)", minval = 0.1, step = 0.1, group = "Stop / Target")

// --- TREND FILTER ---
enableTrendFilter  = input.bool(true, "Enable Trend Filter", group = "Trend Filter",
     tooltip = "Only take Buy signals when price is above the trend EMA, and only take Sell signals when price is below it.")
trendLen           = input.int(200, "Trend EMA Length", group = "Trend Filter")

// --- VOLUME IMBALANCE INPUTS ---
sensitivityFactor  = input.float(1, "Compression Sensitivity", minval = 0.5, maxval = 5.0, step = 0.05, group = "Frequency Engine")
enableVolImbalance = input.bool(true, "Enable Box Volume Imbalance Filter", group = "Volume Imbalance Engine")
volRatioThreshold  = input.float(2.5, "Volume Multiplier Threshold (x Prev N Boxes Avg)", minval = 0, step = 0.1, group = "Volume Imbalance Engine")
volLookbackBoxes   = input.int(8, "Volume Lookback (Boxes, applies to both Buy & Sell)", minval = 1, group = "Volume Imbalance Engine")
showPocLine        = input.bool(true, "Draw Box POC Lines?", group = "Volume Profile / POC Engine")

//=========================
// Market Variables & Filters
//=========================
isWeekend   = dayofweek(time) == 7 or dayofweek(time) == 1
allowSignal = not filterWeekend or not isWeekend
alpha       = 2.0 / (smoothingLen + 1)

trendEma    = ta.ema(close, trendLen)
atrVal      = ta.atr(atrLen)

//=========================
// State Tracking Variables
//=========================
var int barCounter = 0
var float cumVol   = 0.0

var float[] pastGreenBoxVolumes = array.new_float(0)
var float[] pastRedBoxVolumes   = array.new_float(0)

var float smoothUpEff   = na
var float smoothDownEff = na

var float maxHigh   = high
var float minLow    = low
var int startBar    = bar_index
var float startOpen = open

// Live drawing handlers
var box liveBox      = na
var label liveLabel  = na
var line livePocLine = line(na)

if not na(liveBox)
    box.delete(liveBox)
if not na(liveLabel)
    label.delete(liveLabel)
if not na(livePocLine)
    line.delete(livePocLine)

noOpenPosition = strategy.position_size == 0

//=========================
// HELPER FUNCTION: POC
//=========================
f_get_poc(int leftBar, int rightBar) =>
    float maxBarVol = -1.0
    float pocPrice  = na
    int offsetToLeft  = bar_index - leftBar
    int offsetToRight = bar_index - rightBar

    if offsetToLeft >= 0 and offsetToRight >= 0
        for i = offsetToRight to offsetToLeft
            if volume[i] > maxBarVol
                maxBarVol := volume[i]
                pocPrice  := (high[i] + low[i] + close[i]) / 3.0
    [pocPrice, maxBarVol]

//=========================
// HELPER FUNCTION: Position Size Sizing
//=========================
f_calcQty(float stopDistance) =>
    float qty = 0.0
    if useFullLeverage
        float leveragedCapital = strategy.equity * 10.0
        qty := close > 0 ? leveragedCapital / close : 0.0
    else
        float riskAmount = strategy.equity * 0.01
        qty := stopDistance > 0 ? riskAmount / stopDistance : 0.0
    qty

//=========================
// BAR ACCUMULATION
//=========================
barCounter := barCounter + 1
cumVol     := cumVol + volume
maxHigh    := math.max(maxHigh, high)
minLow     := math.min(minLow, low)

if barCounter == 1
    startOpen := open

//=========================
// BOX CLOSING ENGINE
//=========================
if barCounter >= boxSize
    int endBar           = bar_index
    float totalBoxHeight = maxHigh - minLow
    float expectedMove   = na

    bool isBullishBox   = close >= startOpen
    color boxColBg      = isBullishBox ? color.new(color.green, 92) : color.new(color.red, 92)
    color boxColBorder  = isBullishBox ? color.new(color.green, 40) : color.new(color.red, 40)
    color boxColText    = isBullishBox ? color.green : color.red

    string avgVolStr = ""

    float longStopDist  = useAtrStops ? atrVal * atrStopMult   : close * (fixedStopPct / 100.0)
    float longTgtDist   = useAtrStops ? atrVal * atrTargetMult : close * (fixedTargetPct / 100.0)
    float shortStopDist = useAtrStops ? atrVal * atrStopMult   : close * (fixedStopPct / 100.0)
    float shortTgtDist  = useAtrStops ? atrVal * atrTargetMult : close * (fixedTargetPct / 100.0)

    // --- SELL LOGIC ---
    if isBullishBox
        float avgGreenVol = array.size(pastGreenBoxVolumes) > 0 ? array.avg(pastGreenBoxVolumes) : na
        avgVolStr := "Avg Sell Vol (" + str.tostring(volLookbackBoxes) + "): " + (not na(avgGreenVol) ? str.tostring(avgGreenVol, format.volume) : "N/A")

        bool volImbalancePass = not enableVolImbalance or na(avgGreenVol) or (cumVol >= avgGreenVol * volRatioThreshold)
        float currentEff      = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        bool trendOk          = not enableTrendFilter or (close < trendEma)

        if not na(smoothUpEff)
            expectedMove := smoothUpEff * cumVol
            bool expGreaterThanAct = not na(expectedMove) and ((expectedMove * sensitivityFactor) > totalBoxHeight)

            if expGreaterThanAct and volImbalancePass and allowSignal and trendOk and noOpenPosition
                label.new(x=endBar, y=na, text="▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
                float qty = f_calcQty(shortStopDist)
                if qty > 0
                    strategy.entry("Sell", strategy.short, qty=qty)

        smoothUpEff := na(smoothUpEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothUpEff)

        array.push(pastGreenBoxVolumes, cumVol)
        if array.size(pastGreenBoxVolumes) > volLookbackBoxes
            array.shift(pastGreenBoxVolumes)

    // --- BUY LOGIC ---
    else
        float avgRedVol = array.size(pastRedBoxVolumes) > 0 ? array.avg(pastRedBoxVolumes) : na
        avgVolStr := "Avg Buy Vol (" + str.tostring(volLookbackBoxes) + "): " + (not na(avgRedVol) ? str.tostring(avgRedVol, format.volume) : "N/A")

        bool volImbalancePass = not enableVolImbalance or na(avgRedVol) or (cumVol >= avgRedVol * volRatioThreshold)
        float currentEff      = totalBoxHeight / (cumVol > 0 ? cumVol : 1.0)
        bool trendOk          = not enableTrendFilter or (close > trendEma)

        if not na(smoothDownEff)
            expectedMove := smoothDownEff * cumVol
            bool expGreaterThanAct = not na(expectedMove) and ((expectedMove * sensitivityFactor) > totalBoxHeight)

            if expGreaterThanAct and volImbalancePass and allowSignal and trendOk and noOpenPosition
                label.new(x=endBar, y=na, text="▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
                float qty = f_calcQty(longStopDist)
                if qty > 0
                    strategy.entry("Buy", strategy.long, qty=qty)

        smoothDownEff := na(smoothDownEff) ? currentEff : (alpha * currentEff + (1.0 - alpha) * smoothDownEff)

        array.push(pastRedBoxVolumes, cumVol)
        if array.size(pastRedBoxVolumes) > volLookbackBoxes
            array.shift(pastRedBoxVolumes)

    [pocPrice, pocVol] = f_get_poc(startBar, endBar)

    string expStr = not na(expectedMove) ? str.tostring(expectedMove, "#.##") : "N/A"
    string pocStr = not na(pocPrice) ? str.tostring(pocPrice, "#.##") : "N/A"
    string boxTxt = "V: " + str.tostring(cumVol, format.volume) + "\n" + avgVolStr + "\nPOC: " + pocStr + "\nAct H: " + str.tostring(totalBoxHeight, "#.##") + "\nExp H: " + expStr

    box.new(left=startBar, top=maxHigh, right=endBar, bottom=minLow, bgcolor=boxColBg, border_color=boxColBorder)
    label.new(x=math.round((startBar + endBar) / 2), y=isBullishBox ? maxHigh : minLow, text=boxTxt, color=color.new(boxColText, 90), textcolor=boxColText, style=isBullishBox ? label.style_label_down : label.style_label_up, size=size.small)

    if showPocLine and not na(pocPrice)
        line.new(x1=startBar, y1=pocPrice, x2=endBar, y2=pocPrice, color=color.yellow, width=2)

    barCounter := 0
    cumVol     := 0.0
    startBar   := bar_index + 1
    startOpen  := open
    maxHigh    := high
    minLow     := low

//=========================
// LIVE ENGINE LAYER (UNCONFIRMED BOX)
//=========================
else
    bool liveIsBullish = close >= startOpen
    float liveTotalBoxHeight = maxHigh - minLow
    float liveExpectedMove = na

    if liveIsBullish and not na(smoothUpEff)
        liveExpectedMove := smoothUpEff * cumVol
    else if not liveIsBullish and not na(smoothDownEff)
        liveExpectedMove := smoothDownEff * cumVol

    [livePocPrice, livePocVol] = f_get_poc(startBar, bar_index)

    float targetAvgVol = liveIsBullish ? (array.size(pastGreenBoxVolumes) > 0 ? array.avg(pastGreenBoxVolumes) : na) : (array.size(pastRedBoxVolumes) > 0 ? array.avg(pastRedBoxVolumes) : na)

    string liveAvgStr = liveIsBullish ? "Avg Sell Vol (" + str.tostring(volLookbackBoxes) + "): " : "Avg Buy Vol (" + str.tostring(volLookbackBoxes) + "): "
    liveAvgStr := liveAvgStr + (not na(targetAvgVol) ? str.tostring(targetAvgVol, format.volume) : "N/A")

    float ratioVsPrev  = not na(targetAvgVol) and targetAvgVol > 0 ? (cumVol / targetAvgVol) : na
    string ratioStr    = not na(ratioVsPrev) ? str.tostring(ratioVsPrev, "#.##") + "x" : "N/A"

    string liveExpStr = not na(liveExpectedMove) ? str.tostring(liveExpectedMove, "#.##") : "N/A"
    string livePocStr = not na(livePocPrice) ? str.tostring(livePocPrice, "#.##") : "N/A"
    string liveBoxTxt = "Bars: " + str.tostring(barCounter) + "/" + str.tostring(boxSize) + "\nVol Ratio: " + ratioStr + "\nV: " + str.tostring(cumVol, format.volume) + "\n" + liveAvgStr + "\nPOC: " + livePocStr + "\nAct H: " + str.tostring(liveTotalBoxHeight, "#.##") + "\nExp H: " + liveExpStr

    color liveColor = liveIsBullish ? color.green : color.red

    liveBox   := box.new(left=startBar, top=maxHigh, right=bar_index, bottom=minLow, bgcolor=color.new(liveColor, 95), border_color=color.new(liveColor, 50), border_style=line.style_dashed)
    liveLabel := label.new(x=math.round((startBar + bar_index) / 2), y=liveIsBullish ? maxHigh : minLow, text=liveBoxTxt, color=color.new(liveColor, 90), textcolor=liveColor, style=liveIsBullish ? label.style_label_down : label.style_label_up, size=size.small)

    if showPocLine and not na(livePocPrice)
        livePocLine := line.new(x1=startBar, y1=livePocPrice, x2=bar_index, y2=livePocPrice, color=color.yellow, style=line.style_dashed, width=2)

//=========================
// STOP LOSS & TAKE PROFIT
//=========================
if strategy.position_size > 0
    float lStopDist = useAtrStops ? atrVal * atrStopMult   : strategy.position_avg_price * (fixedStopPct / 100.0)
    float lTgtDist  = useAtrStops ? atrVal * atrTargetMult : strategy.position_avg_price * (fixedTargetPct / 100.0)
    strategy.exit("Exit Long", "Buy", stop = strategy.position_avg_price - lStopDist, limit = strategy.position_avg_price + lTgtDist)
else if strategy.position_size < 0
    float sStopDist = useAtrStops ? atrVal * atrStopMult   : strategy.position_avg_price * (fixedStopPct / 100.0)
    float sTgtDist  = useAtrStops ? atrVal * atrTargetMult : strategy.position_avg_price * (fixedTargetPct / 100.0)
    strategy.exit("Exit Short", "Sell", stop = strategy.position_avg_price + sStopDist, limit = strategy.position_avg_price - sTgtDist)